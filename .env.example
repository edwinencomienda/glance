# Copy to .env.prod (gitignored) to run scripts/package-release.sh locally.
# Releases themselves are built by GitHub Actions. Never commit real values. Quote values that
# contain spaces.

# Optional: defaults to the first "Developer ID Application" identity in the keychain.
# SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# App Store Connect API key used by notarytool
APPLE_API_KEY="/absolute/path/to/AuthKey_XXXXXXXXXX.p8"
APPLE_API_KEY_ID=XXXXXXXXXX
APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
